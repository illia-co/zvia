{
  "name": "@zvia/app",
  "version": "0.1.1-beta",
  "description": "Cross-platform SSH workspace for remote Linux servers",
  "author": "Zvia contributors",
  "desktopName": "Zvia",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/orbstack/integration-test.mjs",
    "test:integration:topology": "ZVIA_ORB_INTEGRATION=1 vitest run test/integration/deploymentsTopology.test.ts",
    "test:integration:topology:break": "ZVIA_ORB_INTEGRATION=1 vitest run test/integration/deploymentsTopology.break.test.ts",
    "orbstack:provision": "node scripts/orbstack/run-provision.mjs",
    "orbstack:provision:fullstack": "ZVIA_FULLSTACK=1 node scripts/orbstack/run-provision.mjs",
    "orbstack:test": "npm run test:integration",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish never",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.yml --publish never",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@zvia/shared": "*",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.8.4",
    "@dagrejs/dagre": "^1.1.5",
    "codemirror": "^6.0.2",
    "react-resizable-panels": "^4.12.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "zustand": "^5.0.0"
  }
}
